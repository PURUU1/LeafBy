@model LeafBy.ViewModels.HomeViewModel

@section Styles {
    <style>
        /* Mobile Responsive Fixes - Prevents squashing and enables swipe-scrolling */
        .horizontal-scroller {
            display: flex;
            overflow-x: auto;
            flex-wrap: nowrap;
            gap: 1rem;
            padding-bottom: 10px;
            -webkit-overflow-scrolling: touch; /* Smooth scrolling for iOS */
            scrollbar-width: none; /* Hide scrollbar Firefox */
        }

            .horizontal-scroller::-webkit-scrollbar {
                display: none; /* Hide scrollbar Chrome/Safari */
            }

            .horizontal-scroller .custom-card {
                flex: 0 0 auto; /* Forces cards to stay their original width */
                width: 260px; /* Adjust this if you want cards wider/narrower */
            }

        .calendar-grid {
            display: flex;
            overflow-x: auto;
            flex-wrap: nowrap;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 10px;
        }

            .calendar-grid .day-col {
                flex: 0 0 auto;
                min-width: 120px; /* Prevents calendar days from crushing together on mobile */
            }

        /* Hide scrollbar for a clean mobile app look but keep functionality */
        .plant-scroll-container {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none; /* Firefox */
        }

            .plant-scroll-container::-webkit-scrollbar {
                display: none; /* Chrome/Safari */
            }

        /* Custom styling for the selected plant radio card */
        .plant-radio-input:checked + .plant-radio-label {
            border: 2px solid #d84315 !important;
            background-color: #fce4ec; /* Subtle tint when selected */
            opacity: 1;
            transform: scale(1.05);
        }

        .plant-radio-label {
            cursor: pointer;
            border: 2px solid transparent !important;
            opacity: 0.7;
            transition: all 0.2s ease-in-out;
        }

            .plant-radio-label:hover {
                opacity: 1;
            }
    </style>
}

<!-- ========================================== -->
<!-- 3. MODALS (HIDDEN POPUPS)                  -->
<!-- ========================================== -->
<!-- Add Task Modal -->


<div class="modal fade" id="addTaskModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 20px; background-color: #f7f9f7;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" style="color: #0c3b2e; font-weight: 700; font-size: 1.5rem;">Schedule New Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-muted mb-4" style="font-size: 0.9rem;">Define care parameters for your laboratory.</p>

                <form id="formAddTask">
                    <div class="row mb-3">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold" style="font-size: 0.75rem; color: #5a6d63;">TASK NAME</label>
                            <input type="text" class="form-control shadow-sm border-0" id="taskName" required>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label fw-bold" style="font-size: 0.75rem; color: #5a6d63;">DATE</label>
                            <input type="date" class="form-control border-0 shadow-sm" id="taskDate" required>
                        </div>
                    </div>

                    <label class="form-label fw-bold mb-2" style="font-size: 0.75rem; color: #5a6d63;">TASK CATEGORY</label>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <input type="radio" class="btn-check" name="category" id="catSow" value="Sow" checked>
                        <label class="btn btn-outline-secondary rounded-pill px-3 py-1" for="catSow"><i class="fas fa-seedling me-1"></i> Sow</label>

                        <input type="radio" class="btn-check" name="category" id="catFertilize" value="Fertilize">
                        <label class="btn btn-outline-secondary rounded-pill px-3 py-1" for="catFertilize"><i class="fas fa-leaf me-1"></i> Fertilize</label>

                        <input type="radio" class="btn-check" name="category" id="catCustom" value="Custom">
                        <label class="btn btn-outline-secondary rounded-pill px-3 py-1" for="catCustom" style="border-color: #e57373; color: #e57373;"><i class="fas fa-pencil-alt me-1"></i> Custom</label>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold" style="font-size: 0.75rem; color: #e57373;">CUSTOM INSTRUCTIONS</label>
                        <textarea class="form-control border-0 shadow-sm" id="taskDesc" rows="3" placeholder="e.g., Check Lotus Pond water level..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 0.75rem; color: #5a6d63;">ASSIGN TO (OPTIONAL)</label>

                        <div class="d-flex gap-3 pb-2 plant-scroll-container p-1">

                            <div class="flex-shrink-0">
                                <input type="radio" class="btn-check plant-radio-input" name="taskPlantId" id="plant_none" value="" checked>
                                <label class="plant-radio-label d-flex flex-column align-items-center text-center p-2 rounded-4 shadow-sm bg-white h-100" for="plant_none" style="width: 85px;">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; font-size: 1.2rem; color: #5a6d63;">
                                        <i class="fas fa-border-all"></i>
                                    </div>
                                    <small style="font-size: 0.7rem; line-height: 1.1;" class="fw-bold text-muted text-truncate w-100">General</small>
                                </label>
                            </div>

                            @if (Model?.AppUser?.MyPlants != null)
                            {
                                foreach (var plant in Model.AppUser.MyPlants)
                                {
                                    <div class="flex-shrink-0">
                                        <input type="radio" class="btn-check plant-radio-input" name="taskPlantId" id="plant_@plant.Id" value="@plant.Id">
                                        <label class="plant-radio-label d-flex flex-column align-items-center text-center p-2 rounded-4 shadow-sm bg-white h-100" for="plant_@plant.Id" style="width: 85px;">

                                            <img src="@(!string.IsNullOrEmpty(plant.ImageUrl) ? plant.ImageUrl : "https://placehold.co/100x100/12372A/ffffff?text=Leaf")"
                                                 class="rounded-circle object-fit-cover mb-2 shadow-sm"
                                                 style="width: 50px; height: 50px; border: 2px solid #e0e0e0;"
                                                 alt="@plant.Nickname">

                                            <small style="font-size: 0.7rem; line-height: 1.1;" class="fw-bold text-dark text-truncate w-100" title="@plant.Nickname">
                                                @(string.IsNullOrEmpty(plant.Nickname) ? plant.CommonName : plant.Nickname)
                                            </small>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn px-4 py-2 fw-bold" id="btnSaveTask" style="background-color: #d84315; color: white; border-radius: 10px;">Save Task</button>
            </div>
        </div>
    </div>
</div>
<!-- Task Details Modal -->
<div class="modal fade" id="taskDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title" style="color: #0c3b2e; font-weight: bold;">Task Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h4 id="detailTaskName" class="mb-3" style="color: #0c3b2e;"></h4>
                <div class="d-flex gap-3 mb-3">
                    <div><span class="text-muted small">Category:</span> <br> <span class="fw-bold" id="detailTaskCategory"></span></div>
                    <div><span class="text-muted small">Status:</span> <br> <span id="detailTaskStatus"></span></div>
                </div>
                <div class="p-3 bg-light rounded">
                    <span class="text-muted small">Instructions:</span>
                    <p id="detailTaskDesc" class="mb-0 mt-1"></p>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-outline-danger me-auto" id="btnDeleteTask">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="btnConfirmComplete">
                    <i class="bi bi-check-lg"></i> Mark Completed
                </button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deletePlantModal" tabindex="-1" aria-labelledby="deletePlantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-bottom-0">
                <h5 class="modal-title" id="deletePlantModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i> Remove Plant</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <h4 class="mb-3 text-dark">Are you sure?</h4>
                <p class="text-muted mb-0">Do you really want to remove <strong id="deletePlantNameDisplay" class="text-danger">this plant</strong> from your garden?</p>
                <p class="text-muted small mt-1">This action cannot be undone.</p>

                <form id="formDeletePlant" asp-action="DeletePlant" asp-controller="Plant" method="post" class="mt-4">
                    <input type="hidden" id="deletePlantId" name="id" value="" />
                    <div class="d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger px-4 shadow-sm RemoveFromGarden">Yes, Remove it</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. MAIN CONTENT (PAGE LAYOUT)              -->
<!-- ========================================== -->
<div class="container-fluid mt-4 px-lg-4">
    <!-- Row 1: Calendar & Weather -->
    <div class="row g-4 mb-5">
        <!-- Calendar Widget -->
        <div class="col-12 col-lg-8 col-md-7 mb-4">
            <div class="calendar-widget">
                <div class="calendar-card bg-white p-4 h-100">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                        <h3 style="color: #0c3b2e; font-weight: 700; margin: 0;">Task Calendar</h3>
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-chevron-left" id="prevWeekBtn" style="cursor: pointer; font-size: 1.2rem; font-weight: bold; color: #495057;"></i>
                            <i class="bi bi-chevron-right" id="nextWeekBtn" style="cursor: pointer; font-size: 1.2rem; font-weight: bold; color: #495057;"></i>
                            <button class="btn btn-success rounded-pill ms-2" id="btnAddTask">+ Add Task</button>
                        </div>
                    </div>

                    <!-- Dynamic Custom Calendar Rendered Here -->
                    <div class="calendar-grid" id="weeklyGrid"></div>
                </div>
            </div>
        </div>

        <!-- Weather Widget -->
        <div class="col-12 col-lg-4 col-md-5 mb-4">
            <h2 class="mb-4" style="color: #0c3b2e; font-weight: bold;">Dashboard</h2>

            <div class="weather-widget mb-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <div class="location-label">Location</div>
                        <div class="location-name" id="widgetLocation">Loading...</div>
                    </div>
                    <div class="weather-icon">
                        <i class="bi bi-cloud" id="widgetIcon"></i>
                    </div>
                </div>

                <div class="d-flex align-items-baseline mb-4">
                    <div class="temp-display" id="widgetTemp">--°C</div>
                    <div class="weather-condition" id="widgetCondition">--</div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="growth-label" id="widgetGrowthText">Growth Potential: --</div>
                    <div class="growth-percent" id="widgetGrowthPercent">--%</div>
                </div>
                <div class="progress custom-progress">
                    <div class="progress-bar custom-progress-bar" id="widgetGrowthBar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: My Plants -->
    @* <div class="section-title">
        <span>My Plants</span>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addPlantModal">
            Add Plant Manually
        </button> *@
    </div>

    <div class="horizontal-scroller mb-5">
        @if (Model != null && Model.AppUser != null)
        {
            @foreach (var myPlant in Model.AppUser.MyPlants)
            {
                <div class="custom-card">
                    <div class="card-img-wrapper bg-light">
                        <img src="@myPlant.ImageUrl" alt="Monstera">
                        <div class="status-icon-badge text-success btn-delete-plant " data-plant-id="@myPlant.Id" data-plant-name="@myPlant.CommonName" data-bs-toggle="modal" data-bs-target="#deletePlantModal"><i class="bi bi-x-circle-fill"></i></div>
                    </div>
                    <a asp-controller="Plants" asp-action="Details" asp-route-id="@myPlant.Id" class="" style="text-decoration:none">
                        <h5 class="card-title">@myPlant.CommonName</h5>
                    </a>
                    <p class="card-subtitle mb-0">@myPlant.Location</p>

                    <div class="plant-stats-container">
                        <div class="stat-item-small" title="Water Requirement">
                            <i class="bi bi-droplet-fill icon-water-small"></i> @myPlant.WaterRequirement
                        </div>
                        <div class="stat-item-small" title="Sun Requirement">
                            <i class="bi bi-brightness-high-fill icon-sun-small"></i> @myPlant.SunRequirement
                        </div>
                        <div class="stat-item-small" title="Health Status">
                            <i class="bi bi-heart-pulse-fill icon-health-small"></i> @myPlant.HealthStatus
                        </div>
                    </div>

                    <div>
                        @foreach (var taskI in Model.AppUser.MyTasks)
                        {
                            @if (taskI != null && taskI.MyPlantId.Equals(myPlant.Id))
                            {
                                @if (taskI.Category.Equals("Fertilize"))
                                {
                                    <span class="tag-pill pill-green">@taskI.TaskName</span>
                                }
                                else if (taskI.Category.Equals("Sow"))
                                {
                                    <span class="tag-pill tag-gray">@taskI.TaskName</span>
                                }
                                else
                                {
                                    <span class="tag-pill tag-maroon">@taskI.TaskName</span>
                                }
                            }
                        }
                    </div>
                </div>
            }
        }
        <div class="custom-card" style="background: transparent; border: 2px dashed #d1d5db; display: flex; align-items: center; justify-content: center; min-width: 150px; cursor: pointer;">
            <i class="bi bi-plus text-muted" style="font-size: 2rem;"></i>
        </div>
    </div>

    <!-- Row 3: Community Snapshots -->
    <div class="section-title mt-2">
        <span>Community Snapshots</span>
        <span class="text-muted" style="font-size: 0.8rem; font-weight: normal;">Nearby trade listings</span>
    </div>

    <div class="horizontal-scroller">
        @if (Model != null && Model.AppUser != null && Model.AppUser.MyListings != null)
        {
            @foreach (var Listtings in Model.AppUser.MyListings)
            {
                <div class="custom-card">
                    <div class="card-img-wrapper bg-light" style="height: 120px;">
                        @{
                            var imageAlt = "https://placehold.co/100x100/e9ecef/495057?text=" + Listtings.Title;
                        }
                        <img src="@(string.IsNullOrEmpty(Listtings.ImageUrl) ? imageAlt : Listtings.ImageUrl)" alt="@Listtings.OwnerName" class="">
                    </div>
                    <h5 class="card-title">@Listtings.Title</h5>
                    <div class="user-info">
                        <img src="https://placehold.co/50x50/cccccc/ffffff?text=@Listtings.OwnerName[0].ToString()" alt="User"> @Listtings.OwnerName
                    </div>
                    <button class="btn btn-outline-custom">Trade Interest</button>
                </div>
            }
        }
    </div>

    <!-- Row 4: Discover Plants -->
    <div class="section-title mt-2">
        <span class="text-muted" style="font-size: 0.8rem; font-weight: normal;">Nearby trade listings</span>
    </div>
    <div class="row mb-4 align-items-center">
        <div class="col-md-6 mb-3 mb-md-0">
            <h2 class="catalog-header mb-0">Discover Plants</h2>
            <p class="text-muted mt-1 mb-0">Browse the encyclopedia to add new plants to your garden.</p>
        </div>
    </div>

    @if (Model != null && Model.PlantsCatalog != null)
    {
        <div class="horizontal-scroller">
            @foreach (var catalogItem in Model.PlantsCatalog)
            {
                <div class="custom-card">
                    <div class="card-img-wrapper bg-light">
                        <img src="@catalogItem.ImageUrl" alt="Monstera">
                        <div class="category-badge">
                            Recommended: @{
                            int g = Random.Shared.Next(0, 3);
                            string[] option = new string[] { "LivingRoom", "Patio", "Bedroom", "Hall" };
                            @option[g]
                        }
                    </div>
                </div>
                <a asp-controller="Plants" asp-action="Details" asp-route-id="@catalogItem.Id" class="" style="text-decoration:none">
                    <h5 class="card-title">@catalogItem.CommonName</h5>
                </a>
                <p class="card-subtitle mb-0">@catalogItem.Location</p>

                <div class="plant-stats-container">
                    <div class="stat-item-small" title="Water Requirement">
                        <i class="bi bi-droplet-fill icon-water-small"></i> @catalogItem.WaterRequirement
                    </div>
                    <div class="stat-item-small" title="Sun Requirement">
                        <i class="bi bi-brightness-high-fill icon-sun-small"></i> @catalogItem.SunRequirement
                    </div>
                    <div class="stat-item-small" title="Health Status">
                        <i class="bi bi-heart-pulse-fill icon-health-small"></i> @catalogItem.HealthStatus
                    </div>
                </div>

                <div>
                    @{
                        var taskWithPlant = Model.AppUser?.MyTasks?.FirstOrDefault(x => x.MyPlantId.Equals(catalogItem.Id));
                    }
                    @if (taskWithPlant != null)
                    {
                        <span class="tag-pill pill-green">@taskWithPlant.TaskName</span>
                    }
                    <span class="tag-pill tag-gray"></span>
                    <span class="tag-pill tag-maroon"></span>
                </div>

                <div class="m-4">
                    <input type="hidden" name="catalogId" value="1" />
                    @if (Model.AppUser?.MyPlants?.FirstOrDefault(x => x.Id.Equals(catalogItem.Id)) != null)
                    {
                        <button type="button" class="btn btn-outline-success w-100 rounded-pill AddToGarden disabled bg-success text-white" id="@catalogItem.Id">
                            <i class="bi bi-check-circle-fill me-1"></i> ADDED
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-success w-100 rounded-pill AddToGarden" id="@catalogItem.Id">
                            <i class="bi bi-plus-circle me-1 "></i> Add to Garden
                        </button>
                    }
                </div>
            </div>
        }
    </div>
        }
</div>

<!-- ========================================== -->
<!-- 4. SCRIPTS                                 -->
<!-- ========================================== -->
@section Scripts {
    <script>
        $(document).ready(function () {
            // ==========================================
            // FEATURE 1: CUSTOM WEEKLY CALENDAR LOGIC
            // ==========================================
            let startDateOffset = 0;

            function renderWeeklyCalendar() {
                const grid = $('#weeklyGrid');
                grid.empty();

                let startDate = new Date();
                startDate.setDate(startDate.getDate() + startDateOffset);
                let endDate = new Date(startDate);
                endDate.setDate(startDate.getDate() + 7);

                $.get('/Home/GetTasks', { start: startDate.toISOString(), end: endDate.toISOString() }, function(tasks) {
                    const daysOfWeek = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

                    for(let i = 0; i < 7; i++) {
                        let cellDate = new Date(startDate);
                        cellDate.setDate(startDate.getDate() + i);
                        let dayName = daysOfWeek[cellDate.getDay()];
                        let dateNum = cellDate.getDate();

                        let dateStr = cellDate.getFullYear() + "-" + String(cellDate.getMonth() + 1).padStart(2, '0') + "-" + String(cellDate.getDate()).padStart(2, '0');

                        let dayTasks = (tasks || []).filter(t => t.start && t.start.startsWith(dateStr));

                        let taskHtml = '';
                        dayTasks.forEach(task => {
                            let typeSafe = task.type || "General";
                            let colorClass = getThemeForType(task.type);
                            let completedClass = task.isCompleted ? 'pill-completed' : '';
                            let titleSafe = (task.title || '').replace(/"/g, '&quot;');
                            let descSafe = (task.description || '').replace(/"/g, '&quot;');

                            taskHtml += `
                                <div class="task-pill ${completedClass} ${colorClass} m-1 text-truncate"
                                     data-id="${task.id}"
                                     data-title="${titleSafe}"
                                     data-type="${typeSafe}"
                                     data-desc="${descSafe}"
                                     data-completed="${task.isCompleted}"
                                     title="${titleSafe}"
                                     style="cursor: pointer;">
                                    <div class="${getIconForType(typeSafe)}"></div>${task.title}
                                </div>`;
                        });

                        let isToday = (startDateOffset === 0 && i === 0) ? 'active-bg' : '';

                        grid.append(`
                            <div class="day-col">
                                <div class="day-header">${dayName}</div>
                                <div class="day-cell ${isToday}">
                                    <span class="date-num">${dateNum}</span>
                                    <div class="p-1">
                                        ${taskHtml}
                                    </div>
                                </div>
                            </div>
                        `);
                    }
                });
            }

            renderWeeklyCalendar();
            $('#prevWeekBtn').click(function() { startDateOffset -= 7; renderWeeklyCalendar(); });
            $('#nextWeekBtn').click(function() { startDateOffset += 7; renderWeeklyCalendar(); });

            $(document).on('click', '.task-pill', function(e) {
                e.stopPropagation();
                let $pill = $(this);
                $('#detailTaskName').text($pill.data('title'));
                $('#detailTaskCategory').text($pill.data('type') || "General");
                $('#detailTaskDesc').text($pill.data('desc') || "No additional instructions.");

                let isDone = $pill.data('completed') === true || $pill.data('completed') === "true";
                $('#detailTaskStatus').html(isDone ? '<span class="badge bg-success">Completed</span>' : '<span class="badge bg-warning text-dark">Pending</span>');

                if (isDone) { $('#btnConfirmComplete').hide(); }
                else { $('#btnConfirmComplete').show().data('task-id', $pill.data('id')); }

                $('#btnDeleteTask').data('task-id', $pill.data('id'));
                $('#taskDetailsModal').modal('show');
            });

            // ==========================================
            // FEATURE 2: TASK CRUD OPERATIONS
            // ==========================================
            $('#btnAddTask').click(function () {
                $('#formAddTask')[0].reset();
                document.getElementById('taskDate').valueAsDate = new Date();
                $('#addTaskModal').modal('show');
            });

            $('#btnSaveTask').off('click').on('click', function () {
                let rawPlantId = $('#taskPlantId').val();
                let finalPlantId = (rawPlantId && rawPlantId !== "") ? parseInt(rawPlantId) : null;

                var newTask = {
                    TaskName: $('#taskName').val(),
                    TaskDate: $('#taskDate').val(),
                    Category: $('#taskCategory').val(),
                    Description: $('#taskDesc').val(),
                    IsCompleted: false,
                    MyPlantId: finalPlantId
                };

                if (!newTask.TaskName || !newTask.TaskDate) {
                    alert("Please fill in the Task Name and Date."); return;
                }

                $.ajax({
                    url: '/Home/AddTask', type: 'POST', contentType: 'application/json', data: JSON.stringify(newTask),
                    success: function (response) {
                        if (response.success) { $('#addTaskModal').modal('hide'); renderWeeklyCalendar(); }
                        else { alert("Error: " + response.message); }
                    },
                    error: function (xhr, status, error) { console.error(error); }
                });
            });

            $('#btnConfirmComplete').click(function () {
                let taskId = $(this).data('task-id');
                let $btn = $(this);
                $btn.prop('disabled', true).text('Updating...');

                $.ajax({
                    url: '/Home/CompleteTask', type: 'POST', contentType: 'application/json', data: JSON.stringify({ Id: parseInt(taskId) }),
                    success: function (res) { if (res.success) { $('#taskDetailsModal').modal('hide'); renderWeeklyCalendar(); } },
                    complete: function () { $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Mark Completed'); }
                });
            });

            $('#btnDeleteTask').click(function () {
                let taskId = $(this).data('task-id');
                if (confirm("Delete this task?")) {
                    let $btn = $(this);
                    $btn.prop('disabled', true).text('Deleting...');
                    $.ajax({
                        url: '/Home/DeleteTask', type: 'POST', contentType: 'application/json', data: JSON.stringify({ Id: parseInt(taskId) }),
                        success: function (res) { if (res.success) { $('#taskDetailsModal').modal('hide'); renderWeeklyCalendar(); } },
                        complete: function() { $btn.prop('disabled', false).html('<i class="bi bi-trash"></i> Delete'); }
                    });
                }
            });

            // ==========================================
            // FEATURE 3: WEATHER WIDGET LOGIC
            // ==========================================
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => fetchWeatherData(pos.coords.latitude, pos.coords.longitude),
                    () => fetchWeatherData(null, null)
                );
            } else { fetchWeatherData(null, null); }

            function fetchWeatherData(lat, lon) {
                $.ajax({
                    url: '/Home/GetLiveWidgetData', type: 'GET', data: { latitude: lat, longitude: lon },
                    success: function (data) {
                        $('#widgetLocation').text(data.location);
                        $('#widgetTemp').text(data.temperatureCelsius + '°C');
                        $('#widgetCondition').text(data.condition);
                        $('#widgetGrowthText').text('Growth Potential: ' + data.growthPotentialLevel);
                        $('#widgetGrowthPercent').text(data.growthPercentage + '%');
                        $('#widgetGrowthBar').css('width', data.growthPercentage + '%');
                        let icon = data.condition.toLowerCase().includes('sun') || data.condition.toLowerCase().includes('clear') ? 'bi-sun' : 'bi-cloud';
                        $('#widgetIcon').removeClass().addClass('bi ' + icon);
                    }
                });
            }

            // ==========================================
            // FEATURE 4: PLANT MANAGEMENT
            // ==========================================
            $('.AddToGarden').click(function () {
                let taskId = $(this).attr("id");
                let $btn = $(this);
                $btn.prop('disabled', true).text('Adding...');

                $.ajax({
                    url: '/Plants/AddToGarden', type: 'POST', contentType: 'application/json', data: JSON.stringify({ id: parseInt(taskId) }),
                    success: function (response) { if (response.success) { window.location.reload(); } else { alert("Error: " + response.message); } },
                    complete: function () { $btn.prop('disabled', false).text('Add to Garden'); }
                });
            });

            $('.btn-delete-plant').click(function() {
                $('#deletePlantId').val($(this).data('plant-id'));
                $('#deletePlantNameDisplay').text("'" + $(this).data('plant-name') + "'");
            });

            $('.RemoveFromGarden').click(function () {
                var taskId = $('#deletePlantId').val();
                $.ajax({
                    url: '/Plants/RemoveFromGarden', type: 'POST', contentType: 'application/json', data: JSON.stringify({ id: parseInt(taskId) }),
                    success: function (response) { if (response.success) { window.location.reload(); } else { alert("Error: " + response.message); } }
                });
            });

        });

        function getIconForType(type) {
            switch ((type || '').toLowerCase()) {
                case 'water': return 'bi-droplet';
                case 'sow': return 'bi-flower1';
                case 'prune': return 'bi-scissors';
                case 'fertilize': return 'bi-flask';
                case 'repot': return 'bi-box-seam';
                default: return 'bi-check2-circle';
            }
        }

        function getThemeForType(type) {
            switch ((type || '').toLowerCase()) {
                case 'water': return 'theme-water';
                case 'sow': return 'theme-sow';
                case 'prune': return 'theme-prune';
                case 'fertilize': return 'theme-fert';
                case 'repot': return 'theme-repot';
                default: return 'bg-light text-dark';
            }
        }
    </script>
}