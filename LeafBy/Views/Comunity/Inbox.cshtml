@model IEnumerable<LeafBy.Models.ChatInboxViewModel>
@{
    ViewData["Title"] = "My Messages";
}

@section Styles {
    <style>
        /* Mobile-responsive App Container */
        .chat-app-container {
            /* REMOVED max-width and margin: 0 auto so it fills the screen! */
            width: 100%;
            height: calc(100vh - 130px); /* Stretches to the bottom minus header space */
            background: var(--card-bg, #ffffff);
            border-radius: 1.5rem;
            box-shadow: 0 4px 20px rgba(18, 55, 42, 0.08);
            overflow: hidden;
            border: 1px solid rgba(173, 188, 159, 0.3);
        }

        /* Modern App Header */
        .chat-header {
            background-color: var(--leaf-dark, #12372A);
            color: white;
            padding: 1.5rem;
            border-bottom: 4px solid var(--clay-accent, #d84315);
        }

        /* Hover & Tap Effects for Chat Rows */
        .chat-list-item {
            transition: background-color 0.2s ease, border-left 0.2s ease;
            border-left: 4px solid transparent;
            border-bottom: 1px solid rgba(0,0,0,0.05) !important;
        }

            .chat-list-item:hover, .chat-list-item:focus {
                background-color: var(--leaf-bg, #FBFADA);
                border-left: 4px solid var(--clay-accent, #d84315);
            }

        /* Upgraded Avatars */
        .avatar-circle {
            width: 55px;
            height: 55px;
            background-color: var(--clay-accent, #d84315);
            color: white;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            flex-shrink: 0;
            box-shadow: 0 4px 10px rgba(216, 67, 21, 0.2);
        }

        /* Text Truncation for Mobile */
        .message-preview {
            color: #6c757d;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .time-stamp {
            font-size: 0.75rem;
            color: #adb5bd;
            white-space: nowrap;
        }
    </style>
}

<!-- Removed the padding (py-4) wrapper so it touches the edges of your layout -->
<div class="chat-app-container d-flex flex-column">

    <!-- Chat Header -->
    <div class="chat-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-0 text-white">Inbox</h3>
            <small style="color: rgba(255,255,255,0.8);">@Model.Count() Active Conversations</small>
        </div>
        <!-- Optional: New Message Button -->
        @* <button class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;"> *@
            @* <i class="bi bi-pencil-square fs-5" style="color: var(--leaf-dark, #12372A);"></i> *@
        @* </button> *@
    </div>

    <!-- Chat List -->
    <div class="list-group list-group-flush flex-grow-1 overflow-y-auto" style="background-color: #ffffff;">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-muted mt-5">
                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background-color: var(--leaf-bg, #FBFADA);">
                    <i class="bi bi-chat-dots fs-1" style="color: var(--leaf-medium, #436850);"></i>
                </div>
                <h5 class="fw-bold text-dark">No messages yet</h5>
                <p class="text-center small px-3">Head to the community hub to start a trade or connect with local gardeners!</p>
                <a asp-controller="Comunity" asp-action="Index" class="btn rounded-pill mt-2 text-white fw-bold px-4 shadow-sm" style="background-color: var(--clay-accent, #d84315);">Go to Hub</a>
            </div>
        }
        else
        {
            foreach (var chat in Model)
            {
                <a asp-controller="Comunity"
                   asp-action="DirectChat"
                   asp-route-partnerUsername="@chat.PartnerUsername"
                   class="list-group-item list-group-item-action border-0 p-3 chat-list-item text-decoration-none">

                    <div class="d-flex w-100 align-items-center">
                        <!-- Avatar -->
                        <div class="avatar-circle me-3">
                            @chat.PartnerUsername.Substring(0, 1).ToUpper()
                        </div>

                        <!-- Message Content -->
                        <div class="flex-grow-1 overflow-hidden pe-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="mb-0 fw-bold text-dark text-truncate pe-2">@chat.PartnerUsername</h6>

                                <!-- Formats time dynamically -->
                                <span class="time-stamp">
                                    @if (chat.LastMessageTime.Date == DateTime.Today)
                                    {
                                        @chat.LastMessageTime.ToString("h:mm tt")
                                    }
                                    else
                                    {
                                        @chat.LastMessageTime.ToString("MMM dd")
                                    }
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <p class="mb-0 message-preview pe-3">
                                    @chat.LastMessage
                                </p>
                                <i class="bi bi-chevron-right small text-muted"></i>
                            </div>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</div>