@model LeafBy.ViewModels.HomeViewModel

@section Styles {
    <style>
        /* Mobile Responsive Fixes - Keeps your exact design but prevents breaking */

        /* 1. Make the filter pills swipeable horizontally on small screens */
        .filter-container {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            gap: 0.5rem;
            padding-bottom: 0.5rem;
            -webkit-overflow-scrolling: touch; /* Smooth iOS swipe */
            scrollbar-width: none; /* Hide scrollbar Firefox */
        }

            .filter-container::-webkit-scrollbar {
                display: none; /* Hide scrollbar Chrome/Safari */
            }

        .filter-pill {
            white-space: nowrap; /* Prevents text inside pills from stacking */
        }

        /* 2. On mobile, stack the filter bar and make the Create button full width */
    
    </style>
}

<div class="container mt-5">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end mb-4">
        <div>
            <h1 class="hub-title">Community Exchange Hub</h1>
            <p class="hub-subtitle mb-0">Connect with local botanical enthusiasts. Trade seeds, cuttings, and saplings to expand your garden through community collaboration.</p>
        </div>
    </div>

    <div class="filter-bar-wrapper d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div class="filter-container mb-0">
            <button class="filter-pill active" data-filter="all"><i class="bi bi-infinity me-1"></i> All Items</button>
            <button class="filter-pill" data-filter="trade"><span class="text-success me-1">●</span> Trades</button>
            <button class="filter-pill" data-filter="giveaway"><span class="text-danger me-1">●</span> Giveaways</button>
            <button class="filter-pill" data-filter="wanted"><span class="text-warning me-1">●</span> Wanted</button>
        </div>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addListingModal">
            <i class="bi bi-plus-circle"></i> Create New Listing
        </button>
    </div>

    <div class="row g-4" id="exchangeGrid">

        @foreach (var Listings in Model.AppUser.MyListings)
        {
            @if (Listings.Category.Equals("Giveaway"))
            {
                <div class="col-lg-4 col-md-6 grid-item" data-category="giveaway">
                    <div class="exchange-card h-100 d-flex flex-column">
                        <div class="card-img-wrap">

                            @{
                                var imageAlt = "https://placehold.co/100x100/e9ecef/495057?text=" + Listings.Title;
                            }
                            <img src="@(string.IsNullOrEmpty(Listings.ImageUrl) ? imageAlt : Listings.ImageUrl)" alt="@Listings.OwnerName" class="">
                            <span class="badge-type bg-giveaway">@Listings.Category</span>
                            <span class="badge-distance"><i class="bi bi-geo-alt"></i> @Listings.DistanceMiles km</span>
                        </div>
                        <div class="card-body-custom flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <h3 class="card-title">@Listings.Title</h3>
                            </div>
                            <p class="card-subtitle mt-1">@Listings.PlantType</p>
                            <p class="card-text mt-2">@Listings.Description</p>
                        </div>
                        <div class="card-footer-custom mt-auto">
                            <div class="user-info">
                                <img src='https://placehold.co/100x100/e9ecef/495057?text=@Listings.OwnerName[0].ToString()' alt="User Avatar" class="user-avatar">
                                @Listings.OwnerName
                            </div>
                            <button class="btn-action btn-text-action fw-bold btn-make-request" data-listing-id="@Listings.Id">Message</button>
                        </div>
                        @if (Listings.AppUserId.Equals(Model.AppUser.Id))
                        {
                            <div class="card-footer bg-transparent d-flex justify-content-around mb-1">
                                <button class="btn btn-sm edit-listing-btn"
                                        data-id="@Listings.Id"
                                        data-title="@Listings.Title"
                                        data-category="@Listings.Category"
                                        data-planttype="@Listings.PlantType"
                                        data-listingtype="@Listings.ListingType"
                                        data-imageurl="@Listings.ImageUrl"
                                        data-description="@Listings.Description">
                                    <i class="bi bi-pencil-square"></i>Edit
                                </button>
                                <button class="btn btn-sm text-danger" onclick="deleteListing(@Listings.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        @foreach (var ListingsTrade in Model.AppUser.MyListings)
        {
            @if (ListingsTrade.Category.Equals("Trade"))
            {
                <div class="col-lg-4 col-md-6 grid-item" data-category="trade">
                    <div class="exchange-card h-100 d-flex flex-column">
                        <div class="card-img-wrap">
                            @{
                                var imageAlt = "https://placehold.co/100x100/e9ecef/495057?text=" + ListingsTrade.Title;
                            }
                            <img src="@(string.IsNullOrEmpty(ListingsTrade.ImageUrl) ? imageAlt : ListingsTrade.ImageUrl)" alt="@ListingsTrade.OwnerName" class="">
                            <span class="badge-type bg-giveaway">@ListingsTrade.Category</span>
                            <span class="badge-distance"><i class="bi bi-geo-alt"></i>@ListingsTrade.DistanceMiles km</span>
                        </div>
                        <div class="card-body-custom flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <h3 class="card-title">@ListingsTrade.Title</h3>
                            </div>
                            <p class="card-subtitle mt-1">@ListingsTrade.PlantType</p>
                            <p class="card-text mt-2">@ListingsTrade.Description</p>
                        </div>
                        <div class="card-footer-custom mt-auto">
                            <div class="user-info">
                                <img src="https://placehold.co/100x100/e9ecef/495057?text=@ListingsTrade.OwnerName[0].ToString()" alt="@ListingsTrade.OwnerName" class="user-avatar">
                                @ListingsTrade.OwnerName
                            </div>
                            <button class="btn-action btn-text-action fw-bold btn-make-request" data-listing-id="@ListingsTrade.Id">Message</button>
                        </div>
                        @if (ListingsTrade.AppUserId.Equals(Model.AppUser.Id))
                        {
                            <div class="card-footer bg-transparent d-flex justify-content-around mb-1">
                                <button class="btn btn-sm edit-listing-btn"
                                        data-id="@ListingsTrade.Id"
                                        data-title="@ListingsTrade.Title"
                                        data-category="@ListingsTrade.Category"
                                        data-planttype="@ListingsTrade.PlantType"
                                        data-listingtype="@ListingsTrade.ListingType"
                                        data-imageurl="@ListingsTrade.ImageUrl"
                                        data-description="@ListingsTrade.Description">
                                    <i class="bi bi-pencil-square"></i>Edit
                                </button>
                                <button class="btn btn-sm text-danger" onclick="deleteListing(@ListingsTrade.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        @foreach (var ListingsTrade in Model.AppUser.MyListings)
        {
            @if (ListingsTrade.Category.Equals("Wanted"))
            {
                <div class="col-lg-4 col-md-6 grid-item" data-category="wanted">
                    <div class="exchange-card h-100 d-flex flex-column" style="background-color: #faf8f5;">
                        <div class="card-img-wrap" style="background-color: #f3ece7; height: 160px;">
                            <span class="badge-type bg-wanted">@ListingsTrade.Category</span>
                            <span class="badge-distance"><i class="bi bi-geo-alt"></i> @ListingsTrade.DistanceMiles km</span>
                            <div class="wanted-icon-wrap"><i class="bi bi-flower1"></i></div>
                        </div>
                        <div class="card-body-custom flex-grow-1">
                            <h3 class="card-title mt-2">@ListingsTrade.Title</h3>
                            <p class="card-subtitle mt-1">@ListingsTrade.ListingType</p>
                            <p class="card-text mt-2">@ListingsTrade.Description</p>
                        </div>
                        <div class="card-footer-custom mt-auto">
                            <div class="user-info">
                                <img src='https://placehold.co/100x100/e9ecef/495057?text=@ListingsTrade.OwnerName[0].ToString()' alt="Avatar" class="">
                                @ListingsTrade.OwnerName
                            </div>
                            <button class="btn-action btn-text-action fw-bold btn-make-request" data-listing-id="@ListingsTrade.Id">Message</button>
                        </div>
                        @if (ListingsTrade.AppUserId.Equals(Model.AppUser.Id))
                        {
                            <div class="card-footer bg-transparent d-flex justify-content-around mb-1">
                                <button class="btn btn-sm edit-listing-btn"
                                        data-id="@ListingsTrade.Id"
                                        data-title="@ListingsTrade.Title"
                                        data-category="@ListingsTrade.Category"
                                        data-planttype="@ListingsTrade.PlantType"
                                        data-listingtype="@ListingsTrade.ListingType"
                                        data-imageurl="@ListingsTrade.ImageUrl"
                                        data-description="@ListingsTrade.Description">
                                    <i class="bi bi-pencil-square"></i>Edit
                                </button>
                                <button class="btn btn-sm text-danger" onclick="deleteListing(@ListingsTrade.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }

    </div>

    <div class="modal fade" id="requestModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Make an Offer / Send Message</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="requestForm">
                        <input type="hidden" id="reqListingId">
                        <div class="mb-3">
                            <label class="form-label">Your Message</label>
                            <textarea class="form-control" id="reqMessage" rows="4" placeholder="e.g., I would love to trade my Spider Plant for this! When are you available?" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitListingRequest()">Send Request</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="addListingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Listing</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addListingForm">
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="addTitle" placeholder="e.g., Pothos Cutting" required>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-6 mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" id="addCategory">
                                    <option value="Trade">Trade</option>
                                    <option value="Giveaway">Giveaway</option>
                                    <option value="Wanted">Wanted</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label class="form-label">Plant Type</label>
                                <select class="form-select" id="addPlantType">
                                    <option value="Cutting">Cutting</option>
                                    <option value="Sapling">Sapling</option>
                                    <option value="Seeds">Seeds</option>
                                    <option value="Mature">Mature</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Listing Type</label>
                            <select class="form-select" id="addListingType">
                                <option value="Trade">Trade</option>
                                <option value="Free">Free</option>
                                <option value="Sell">Sell</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Image URL (Optional)</label>
                            <input type="text" class="form-control" id="addImage" placeholder="https://...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" id="addDesc" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" onclick="submitNewListing()">Post Listing</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editListingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Listing</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editListingForm">
                        <input type="hidden" id="editId"> <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="editTitle" required>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-6 mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" id="editCategory">
                                    <option value="Plant">Plant</option>
                                    <option value="Giveaway">Giveaway</option>
                                    <option value="Wanted">Wanted</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label class="form-label">Plant Type</label>
                                <select class="form-select" id="editPlantType">
                                    <option value="Cutting">Cutting</option>
                                    <option value="Sapling">Sapling</option>
                                    <option value="Seeds">Seeds</option>
                                    <option value="Mature">Mature</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Listing Type</label>
                            <select class="form-select" id="editListingType">
                                <option value="Trade">Trade</option>
                                <option value="Free">Free</option>
                                <option value="Sell">Sell</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Image URL</label>
                            <input type="text" class="form-control" id="editImage">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" id="editDesc" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitEditListing()">Save Changes</button>
                </div>
            </div>
        </div>
    </div>


    <h3 class="mt-5 mb-4 hub-title">Community Requests</h3>

    <ul class="nav nav-tabs border-bottom-0 mb-4" id="requestTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold px-4" data-bs-toggle="tab" data-bs-target="#incoming" style="border-radius: 10px 10px 0 0;">
                <i class="bi bi-inbox-fill me-2"></i>Incoming Offers
                <span class="badge ms-1 rounded-pill" style="background-color:rgb(21, 115, 71)">@Model.IncomingRequests.Count(r => r.Status == "Pending")</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold px-4 text-muted" data-bs-toggle="tab" data-bs-target="#outgoing" style="border-radius: 10px 10px 0 0;">
                <i class="bi bi-send-fill me-2"></i>My Sent Requests
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="incoming">
            <div class="row">
                @if (!Model.IncomingRequests.Any())
                {
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        No incoming requests at the moment.
                    </div>
                }

                @foreach (var req in Model.IncomingRequests)
                {
                    <div class="col-12 mb-3">
                        <div class="card exchange-card shadow-sm border-0" style="border-left: 5px solid @(req.Status == "Pending" ? "#ffc107" : (req.Status == "Accepted" ? "#198754" : "#6c757d")) !important;">
                            <div class="card-body-custom p-4">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start mb-3 gap-2">
                                    <div class="user-info d-flex align-items-center">
                                        <img src="https://placehold.co/100x100/e9ecef/495057?text=@(req.Requester?.UserName?[0].ToString() ?? "U")" alt="User Avatar" class="user-avatar me-2" style="width: 40px; height: 40px; border-radius: 50%;">
                                        <div>
                                            <h5 class="mb-0 fw-bold">@req.Requester?.UserName</h5>
                                            <small class="text-muted">Requested your <strong>@req.Listing?.Title</strong></small>
                                        </div>
                                    </div>

                                    <span class="badge @(req.Status == "Pending" ? "bg-warning text-dark" : (req.Status == "Accepted" ? "bg-success" : "bg-secondary")) px-3 py-2 rounded-pill">
                                        @req.Status
                                    </span>
                                </div>

                                <div class="p-3 rounded mb-3" style="background-color: #f8f9fa; border: 1px dashed #dee2e6;">
                                    <i class="bi bi-chat-quote text-muted me-2 fs-5 align-middle"></i>
                                    <span class="fst-italic text-secondary">"@req.Message"</span>
                                </div>

                                @if (req.Status == "Pending")
                                {
                                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 border-top pt-3 mt-2">
                                        <button class="btn btn-outline-danger px-4" onclick="updateReqStatus(@req.Id, 'Rejected')">
                                            <i class="bi bi-x-lg me-1"></i> Decline
                                        </button>
                                        <button class="btn btn-success px-4" onclick="updateReqStatus(@req.Id, 'Accepted')">
                                            <i class="bi bi-check-lg me-1"></i> Accept
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="outgoing">
            <div class="row">
                @if (!Model.OutgoingRequests.Any())
                {
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="bi bi-send fs-1 d-block mb-2"></i>
                        You haven't sent any requests yet.
                    </div>
                }

                @foreach (var req in Model.OutgoingRequests)
                {
                    <div class="col-12 mb-3">
                        <div class="card exchange-card shadow-sm border-0">
                            <div class="card-body-custom p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h5 class="mb-0 fw-bold">@req.Listing?.Title</h5>
                                        <small class="text-muted">Request sent to owner</small>
                                    </div>
                                    <span class="badge @(req.Status == "Pending" ? "bg-warning text-dark" : (req.Status == "Accepted" ? "bg-success" : "bg-danger")) px-3 py-2 rounded-pill">
                                        @req.Status
                                    </span>
                                </div>

                                <div class="p-3 rounded" style="background-color: #faf8f5; border: 1px solid #f3ece7;">
                                    <strong class="text-muted d-block mb-1">Your Message:</strong>
                                    <span class="text-secondary">"@req.Message"</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateReqStatus(id, newStatus) {
            $.ajax({
                url: '/Home/UpdateRequestStatus',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ RequestId: id, NewStatus: newStatus }),
                success: function(res) {
                    if(res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function submitNewListing() {
            const payload = {
                Title: $('#addTitle').val(),
                Category: $('#addCategory').val(),
                PlantType: $('#addPlantType').val(),
                ListingType: $('#addListingType').val(),
                ImageUrl: $('#addImage').val(),
                Description: $('#addDesc').val(),
                OwnerName: '@Model.AppUser.UserName.ToString()'
            };
            $.ajax({
                url: '/Comunity/CreateListing',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        $('#addListingModal').modal('hide');
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                }
            });
        }

        function deleteListing(listingId) {
            if (confirm("Are you sure you want to delete this listing?")) {
                $.ajax({
                    url: '/Comunity/DeleteListing',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Id: listingId }),
                    success: function (response) {
                        if (response.success) {
                            $('#listing-card-' + listingId).fadeOut(400, function() { $(this).remove(); });
                            location.reload(); // Quick refresh to update DB state visually
                        } else {
                            alert(response.message);
                        }
                    }
                });
            }
        }

        $(document).ready(function() {
            // Heart Icon Toggle
            $('.btn-save-item').click(function() {
                $(this).toggleClass('saved');
                let icon = $(this).find('i');
                if($(this).hasClass('saved')) {
                    icon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                } else {
                    icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart');
                }
            });

            // Filter Pills Logic
            $('.filter-pill[data-filter]').click(function() {
                $('.filter-pill[data-filter]').removeClass('active');
                $(this).addClass('active');

                let filterValue = $(this).data('filter');
                if (filterValue === 'all') {
                    $('.grid-item').fadeIn(300);
                } else {
                    $('.grid-item').hide();
                    $('.grid-item[data-category="' + filterValue + '"]').fadeIn(300);
                }
            });

            // Distance Slider
            $('#distanceRange').on('input', function() {
                let val = $(this).val();
                $('#distanceLabel').text('Distance: ' + val + 'km');
            });

            // Edit Modal Population
            $('.edit-listing-btn').on('click', function () {
                $('#editId').val($(this).data('id'));
                $('#editTitle').val($(this).data('title'));
                $('#editCategory').val($(this).data('category'));
                $('#editPlantType').val($(this).data('planttype'));
                $('#editListingType').val($(this).data('listingtype'));
                $('#editImage').val($(this).data('imageurl'));
                $('#editDesc').val($(this).data('description'));
                $('#editListingModal').modal('show');
            });

            // Open Message Request Modal
            $('.btn-make-request').on('click', function () {
                let listingId = $(this).data('listing-id');
                $('#reqListingId').val(listingId);
                $('#reqMessage').val('');
                $('#requestModal').modal('show');
            });
        });

        function submitListingRequest() {
            const payload = {
                ComunityListingId: parseInt($('#reqListingId').val()),
                Message: $('#reqMessage').val()
            };

            if (!payload.Message.trim()) {
                alert("Please enter a message before sending.");
                return;
            }

            $.ajax({
                url: '/Comunity/SubmitRequest',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        $('#requestModal').modal('hide');
                        alert("Your request was sent to the owner successfully!");
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("An error occurred while sending the request.");
                }
            });
        }

        function submitEditListing() {
            const payload = {
                Id: parseInt($('#editId').val()),
                Title: $('#editTitle').val(),
                Category: $('#editCategory').val(),
                PlantType: $('#editPlantType').val(),
                ListingType: $('#editListingType').val(),
                ImageUrl: $('#editImage').val(),
                Description: $('#editDesc').val()
            };

            $.ajax({
                url: '/Comunity/EditListing',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        $('#editListingModal').modal('hide');
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                }
            });
        }
    </script>
}