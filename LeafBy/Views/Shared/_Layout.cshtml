        <script>
            const globalConnection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            globalConnection.on("ReceiveDirectMessage", function (sender, message, timestamp) {
                const currentPath = window.location.pathname.toLowerCase();
                const urlParams = new URLSearchParams(window.location.search);
                const partnerInUrl = urlParams.get('partnerUsername');

                const isActivelyChatting = currentPath.includes('/comunity/directchat') && partnerInUrl === sender;
                const isMyOwnMessage = sender === '@User.Identity.Name';

                if (!isActivelyChatting && !isMyOwnMessage) {
                    document.getElementById('toastSender').innerText = sender;
                    let snippet = message.length > 40 ? message.substring(0, 40) + '...' : message;
                    document.getElementById('toastMessage').innerText = snippet;
                    document.getElementById('toastLink').href = `/Community/DirectChat?partnerUsername=${sender}`;

                    const toastElement = document.getElementById('messageToast');
                    const toast = new bootstrap.Toast(toastElement, { delay: 5000 });
                    toast.show();
                }
            });

            globalConnection.start().catch(function (err) {
                console.error("Global Notification Hub Error: ", err.toString());
            });

        </script>
    }
    
