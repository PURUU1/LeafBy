    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const video = document.getElementById('cameraStream');
        const preview = document.getElementById('cameraPreview');
        const placeholder = document.getElementById('cameraPlaceholder');
        const btnStartCamera = document.getElementById('btnStartCamera');
        const btnCapture = document.getElementById('btnCapture');
        const btnRetake = document.getElementById('btnRetake');
        const hiddenInput = document.getElementById('capturedImageData');
        const scannerForm = document.getElementById('scannerForm');
        let stream = null;

        // 1. START CAMERA FUNCTION
        async function startCamera() {
            try {
                // Request the rear-facing camera
                stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { facingMode: 'environment' }, 
                    audio: false 
                });
                
                video.srcObject = stream;
                video.style.display = 'block';
                placeholder.style.display = 'none';
                preview.style.display = 'none';
                
                // Show capture button
                btnCapture.style.setProperty('display', 'flex', 'important');
                btnRetake.style.display = 'none';
                hiddenInput.value = ''; // clear previous capture
            } catch (err) {
                console.error("Camera access denied or unavailable: ", err);
                alert("Could not access the camera. Please ensure you have granted permissions.");
            }
        }

        // 2. STOP CAMERA FUNCTION (To save battery when not in use)
        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                video.srcObject = null;
            }
        }

        // EVENT: User clicks 'Start Camera'
        btnStartCamera.addEventListener('click', startCamera);

        // EVENT: User clicks the round Capture button
        btnCapture.addEventListener('click', function () {
            // Draw the current video frame to a temporary canvas
            const canvas = document.createElement('canvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0);

            // Get the image data as a Base64 string
            const imageDataUrl = canvas.toDataURL('image/jpeg', 0.8);
            
            // Set it to preview and save it to the hidden input
            preview.src = imageDataUrl;
            hiddenInput.value = imageDataUrl;

            // UI Swaps
            video.style.display = 'none';
            preview.style.display = 'block';
            btnCapture.style.setProperty('display', 'none', 'important');
            btnRetake.style.display = 'block';

            stopCamera(); // Turn off the actual webcam light
        });

        // EVENT: User clicks 'Retake'
        btnRetake.addEventListener('click', startCamera);

        // Turn off camera if they switch to the Upload tab
        document.getElementById('upload-tab').addEventListener('shown.bs.tab', stopCamera);
        
        // Turn on camera if they switch back to the Camera tab
        document.getElementById('camera-tab').addEventListener('shown.bs.tab', function() {
            if (hiddenInput.value === '') {
                startCamera();
            }
        });

        // 3. FORM SUBMISSION INTERCEPTION
        scannerForm.addEventListener('submit', function (e) {
            e.preventDefault(); // Stop normal form submission

            let formData = new FormData();
            
            // Grab the selected category
            const category = document.querySelector('input[name="scanType"]:checked').value;
            formData.append('category', category);

            // Determine if we are sending the Captured Photo OR the Uploaded File
            const activeTabId = document.querySelector('#scanMethodTabs .active').id;
            
            if (activeTabId === 'camera-tab' && hiddenInput.value) {
                // Convert the Base64 string into a physical File object
                const file = dataURLtoFile(hiddenInput.value, `scan_${Date.now()}.jpg`);
                formData.append('scanImage', file);
            } else {
                // Grab the file from the traditional file input
                const fileInput = document.getElementById('scanImage');
                if (fileInput.files.length > 0) {
                    formData.append('scanImage', fileInput.files[0]);
                } else {
                    alert("Please capture a photo or upload an image.");
                    return;
                }
            }

            // Change button to show loading state
            const btnSubmit = document.getElementById('btnStartScan');
            btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';
            btnSubmit.disabled = true;

            // Send the exact data payload your C# Controller is expecting via AJAX
            fetch('@Url.Action("UploadToSession", "PlantScanner")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = data.redirectUrl; // Follow your C# redirect
                } else {
                    alert(data.message);
                    btnSubmit.innerHTML = 'Start Scan';
                    btnSubmit.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                btnSubmit.innerHTML = 'Start Scan';
                btnSubmit.disabled = false;
            });
        });

        // HELPER FUNCTION: Converts Base64 back into an IFormFile compatible object
        function dataURLtoFile(dataurl, filename) {
            let arr = dataurl.split(','), mime = arr[0].match(/:(.*?);/)[1],
                bstr = atob(arr[1]), n = bstr.length, u8arr = new Uint8Array(n);
            while(n--){
                u8arr[n] = bstr.charCodeAt(n);
            }
            return new File([u8arr], filename, {type:mime});
        }
    });
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
