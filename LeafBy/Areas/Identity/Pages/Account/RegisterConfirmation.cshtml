@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registration Complete";
}

<div class="text-center mt-4">
    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-4" style="width: 80px; height: 80px;">
        <i class="fas fa-envelope fs-2" style="color: #0c3b2e;"></i>
    </div>

    <h2 class="fw-bold mb-2" style="color: #0c3b2e;">Check Your Email</h2>

    @{
        if (@Model.DisplayConfirmAccountLink)
        {
            <p class="text-muted mb-4">
                This app does not currently have a real email sender registered.
            </p>
            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn w-100 py-3 rounded-pill fw-bold" style="background-color: #0c3b2e; color: white; text-decoration: none;">
            Click here to confirm
            </a>
        }
        else
        {
            <p class="text-muted mb-5">
                Please check your email inbox to confirm your account and access the laboratory.
            </p>
            <a asp-page="./Login" class="btn w-100 py-3 rounded-pill fw-bold" style="background-color: #0c3b2e; color: white; text-decoration: none;">Return to Login</a>
        }
    }
</div>