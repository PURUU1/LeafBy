@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend Verification";
}

<h2 class="fw-bold mb-1" style="color: #0c3b2e;">Resend Verification</h2>
<p class="text-muted mb-4">Didn't receive your lab access verification email? Request a new one below.</p>

<form method="post">
    <div asp-validation-summary="All" class="alert alert-danger border-0 small" role="alert"></div>

    <div class="mb-4">
        <label asp-for="Input.Email" class="form-label fw-bold small text-uppercase" style="color: #5a6d63;">Email Address</label>
        <input asp-for="Input.Email" class="form-control bg-light border-0 py-3" aria-required="true" placeholder="botanist@lab.com" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold" style="background-color: #0c3b2e; color: white;">Resend Link</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}