@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

@section HeroContent {
    <h1 class="display-4 fw-medium text-white mb-3" style="line-height: 1.1;">Your garden,<br>always growing.</h1>
    <p class="text-white-50 mb-4" style="max-width: 400px; font-size: 1.1rem;">Track your terrace garden, diagnose plant health with AI, and connect with a community of growers.</p>
    <div>
        <span class="glass-badge"><i class="bi bi-stars text-warning"></i> AI Diagnosis</span>
        <span class="glass-badge"><i class="bi bi-flower1 text-danger"></i> Garden Tracker</span>
        <span class="glass-badge"><i class="bi bi-people-fill text-info"></i> Plant Trading</span>
    </div>
}

<div class="w-100 mt-5" style="max-width: 400px; margin: 0 auto;">
    <span class="super-label">Welcome Back</span>
    <h1 class="serif-heading mb-1">Sign in to LeafBy</h1>
    <p class="text-muted mb-5">Pick up right where your garden left off.</p>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-4">
            <label asp-for="Input.Email" class="super-label">Email Address</label>
            <div class="position-relative">
                <i class="bi bi-envelope position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                <input asp-for="Input.Email" class="input-dark ps-5" autocomplete="username" placeholder="you@example.com" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label asp-for="Input.Password" class="super-label mb-0">Password</label>
                <a asp-page="./ForgotPassword" class="super-label mb-0 text-decoration-none">Forgot Password?</a>
            </div>
            <div class="position-relative">
                <i class="bi bi-lock position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                <input asp-for="Input.Password" class="input-dark ps-5" autocomplete="current-password" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe">
            <label class="form-check-label text-muted small" for="rememberMe">Keep me signed in for 30 days</label>
        </div>

        <button id="login-submit" type="submit" class="btn w-100 py-2 rounded-3 text-dark fw-bold mb-4" style="border: 1px solid #e5e7eb; background: #fff;">
            Sign in
        </button>

        <p class="text-center text-muted small mb-0">
            Don't have an account? <a asp-page="./Register" class="text-dark fw-bold text-decoration-none">Create one — it's free</a>
        </p>
    </form>
    <div class="d-flex align-items-center mb-4 mt-4">
        <hr class="flex-grow-1">
        <span class="mx-3 text-muted small">or continue with</span>
        <hr class="flex-grow-1">
    </div>


    @{
        if ((Model.ExternalLogins?.Count ?? 0) != 0)
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn w-100 py-2 rounded-3 text-muted fw-bold d-flex align-items-center justify-content-center gap-2 mb-5" name="provider" value="@provider.Name" style="border: 1px solid #e5e7eb; background: #fff;">
                        <i class="bi bi-google text-dark"></i> Sign in with @provider.DisplayName
                    </button>
                }
            </form>
        }
    }
</div>