@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="fw-bold mb-4" style="color: #0c3b2e;">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="p-4 bg-light rounded-4 mb-4">
            <p class="text-muted mb-2">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
            <p class="small fw-bold text-danger mb-0">
                <i class="fas fa-exclamation-triangle me-1"></i> Deleting this data will permanently remove your account, and this cannot be recovered.
            </p>
        </div>

        <form id="download-data" asp-page="DownloadPersonalData" method="post" class="mb-3">
            <button class="btn w-100 py-3 rounded-pill fw-bold" type="submit" style="background-color: #0c3b2e; color: white;">
                Download My Data
            </button>
        </form>

        <a id="delete" asp-page="DeletePersonalData" class="btn w-100 py-3 rounded-pill fw-bold" style="background-color: #d84315; color: white;">
            Delete Account
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}