@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<h2 class="fw-bold mb-1" style="color: #0c3b2e;">Reset Lab Access</h2>
<p class="text-muted mb-4">Enter your email address and we will send you a link to reset your password.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small" role="alert"></div>

    <div class="mb-4">
        <label asp-for="Input.Email" class="form-label fw-bold small text-uppercase" style="color: #5a6d63;">Email Address</label>
        <input asp-for="Input.Email" class="form-control bg-light border-0 py-3" autocomplete="username" aria-required="true" placeholder="botanist@lab.com" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold" style="background-color: #0c3b2e; color: white;">Send Reset Link</button>
</form>

<p class="mt-4 text-center small text-muted">
    Remembered your password? <a asp-page="./Login" style="color: #d84315; text-decoration: none; font-weight: bold;">Return to login</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}