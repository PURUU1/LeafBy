@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

@section HeroContent {
    <h1 class="display-4 fw-medium text-white mb-3" style="line-height: 1.1;">Every expert was<br><span class="text-success opacity-75">once a seedling.</span></h1>
    <p class="text-white-50 mb-4" style="max-width: 400px; font-size: 1.1rem;">Join thousands of terrace gardeners sharing knowledge, cuttings, and care tips.</p>
    <div>
        <span class="glass-badge"><i class="bi bi-flower3 text-pink"></i> Free forever</span>
        <span class="glass-badge"><i class="bi bi-cpu text-secondary"></i> AI-powered</span>
        <span class="glass-badge"><i class="bi bi-globe-americas text-primary"></i> Community</span>
    </div>
}

<div class="w-100 mt-5" style="max-width: 400px; margin: 0 auto;">
    <span class="super-label">New Here?</span>
    <h1 class="serif-heading mb-1">Create your account</h1>
    <p class="text-muted mb-4">Start tracking your garden in under a minute.</p>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        @* <div class="row g-3 mb-3">
            <div class="col-6">
                <label class="super-label">First Name</label>
                <input class="input-dark" placeholder="Aanya" />
            </div>
            <div class="col-6">
                <label class="super-label">Last Name</label>
                <input class="input-dark" placeholder="Sharma" />
            </div>
        </div> *@

        <div class="mb-3">
            <label asp-for="Input.Email" class="super-label">Email Address</label>
            <div class="position-relative">
                <i class="bi bi-envelope position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                <input asp-for="Input.Email" class="input-dark ps-5" placeholder="you@example.com" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="super-label">Password</label>
            <div class="position-relative">
                <i class="bi bi-lock position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                <input asp-for="Input.Password" class="input-dark ps-5" placeholder="Min. 8 characters" />
            </div>
            <div class="d-flex gap-1 mt-2">
                <div class="bg-success rounded" style="height: 4px; flex: 1;"></div>
                <div class="bg-success rounded" style="height: 4px; flex: 1;"></div>
                <div class="bg-success rounded" style="height: 4px; flex: 1;"></div>
                <div class="bg-light rounded" style="height: 4px; flex: 1;"></div>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword" class="super-label">Confirm Password</label>
            <div class="position-relative">
                <i class="bi bi-shield-check position-absolute text-muted" style="left: 12px; top: 12px;"></i>
                <input asp-for="Input.ConfirmPassword" class="input-dark ps-5" placeholder="Repeat password" />
            </div>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" required>
            <label class="form-check-label text-muted small">I agree to the <a href="#" class="text-dark fw-bold">Terms of Service</a> and <a href="#" class="text-dark fw-bold">Privacy Policy</a></label>
        </div>

        <button id="register-submit" type="submit" class="btn w-100 py-2 rounded-3  fw-bold mb-4" style="border: 1px solid #e5e7eb; ">
            Create account
        </button>

        <p class="text-center text-muted small">
            Already have an account? <a asp-page="./Login" class="text-dark fw-bold text-decoration-none">Sign in</a>
        </p>
    </form>
</div>